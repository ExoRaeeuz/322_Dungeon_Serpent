<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>DungeonSerpent</RootNamespace>
    <AssemblyName>DungeonSerpent</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.1.303" />
    <!-- MonoGame.Content.Builder.Task is intentionally excluded.           -->
    <!-- This project generates ALL textures, fonts, and audio at runtime  -->
    <!-- via TextureFactory, BitmapFont, and SoundManager — no .mgcb       -->
    <!-- content pipeline step is needed or used.                          -->
  </ItemGroup>
</Project>
